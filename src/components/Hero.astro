---
import { site } from '../data/site';

const stats = [
	{ value: '10万+', label: '签发证书' },
	{ value: '99.99%', label: '服务可用性' },
	{ value: '7×24', label: '专业支持' },
	{ value: '500+', label: '企业客户' },
];
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50/70 via-white to-white dark:bg-night-950 dark:from-night-900 dark:via-night-950 dark:to-night-950">
	<!-- 网格背景 -->
	<div aria-hidden class="pointer-events-none absolute inset-0 grid-bg" />
	<!-- 装饰层 -->
	<div aria-hidden class="pointer-events-none absolute inset-0">
		<!-- 顶部主光晕 -->
		<div class="absolute -top-32 left-1/2 h-[30rem] w-[30rem] -translate-x-1/2 rounded-full bg-brand-500/25 blur-3xl dark:bg-brand-500/20" />
		<!-- 两侧彩色光晕 -->
		<div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-brand-400/15 blur-3xl dark:bg-brand-400/10" />
		<div class="absolute top-1/2 left-0 h-72 w-72 rounded-full bg-purple-500/15 blur-3xl dark:bg-purple-500/10" />
		<div class="absolute top-10 right-10 h-40 w-40 rounded-full bg-cyan-400/10 blur-2xl dark:bg-cyan-400/10" />
		<!-- 发光圆环装饰 -->
		<div class="absolute -left-16 top-16 h-40 w-40 rounded-full border border-brand-500/20 dark:border-brand-400/20" />
		<div class="absolute -right-10 bottom-24 h-28 w-28 rounded-full border border-purple-500/20 dark:border-purple-400/20" />
		<div class="absolute left-1/4 top-8 h-3 w-3 rounded-full bg-brand-400/40 dark:bg-brand-300/50" />
		<div class="absolute right-1/4 top-20 h-2 w-2 rounded-full bg-purple-400/40 dark:bg-purple-300/50" />
		<div class="absolute bottom-16 left-1/5 h-2.5 w-2.5 rounded-full bg-brand-400/40 dark:bg-brand-300/50" />
	</div>

	<div class="relative mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-32">
		<span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-sm font-medium text-brand-700 dark:text-brand-200">
			<span class="h-2 w-2 animate-pulse rounded-full bg-brand-500 dark:bg-brand-400" />
			可信网络安全与基础服务提供商
		</span>
		<h1 class="mx-auto mt-6 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-6xl dark:text-white">
			构建安全可信的
			<span class="gradient-text">数字世界</span>
		</h1>
		<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
			{site.description}
		</p>
		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href="/products/ssl"
				class="group inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-brand-500 to-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-500/30 transition hover:from-brand-400 hover:to-brand-500"
			>
				进入 SSL 证书平台
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
				</svg>
			</a>
			<a
				href="/contact"
				class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-8 py-3.5 text-base font-semibold text-slate-700 transition hover:border-brand-500/40 hover:text-brand-600 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
			>
				联系我们
			</a>
		</div>

		<!-- 数据指标 -->
		<div class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
			{
				stats.map((s) => (
					<div class="text-center">
						<p class="text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">{s.value}</p>
						<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{s.label}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
