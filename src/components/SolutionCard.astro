---
interface Props {
	title: string;
	desc: string;
}
const { title, desc } = Astro.props;
---

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow-md">
	<span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-50 text-brand-600">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
		</svg>
	</span>
	<h3 class="mt-4 text-base font-bold text-slate-900">{title}</h3>
	<p class="mt-2 text-sm leading-relaxed text-slate-500">{desc}</p>
</div>
