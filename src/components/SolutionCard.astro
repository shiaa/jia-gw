---
interface Props {
	title: string;
	desc: string;
}
const { title, desc } = Astro.props;
---

<div class="dark-card group p-6">
	<span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-500/15 text-brand-300 transition group-hover:bg-brand-500 group-hover:text-white">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
		</svg>
	</span>
	<h3 class="mt-4 text-base font-bold text-white">{title}</h3>
	<p class="mt-2 text-sm leading-relaxed text-slate-400">{desc}</p>
</div>
