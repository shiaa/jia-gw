---
import { site, navLinks } from '../data/site';

const { pathname = '/' } = Astro.url;
function isActive(href: string) {
	if (href === '/') return pathname === '/' || pathname === '';
	return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/90 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
		<!-- Logo -->
		<a href="/" class="flex items-center gap-2 text-lg font-bold text-brand-600">
			<span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-600 text-white">
				A
			</span>
			<span>{site.brand}</span>
		</a>

		<!-- 桌面端导航 -->
		<nav class="hidden items-center gap-1 md:flex">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class:list={[
							'rounded-lg px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900',
							isActive(link.href) && 'bg-slate-100 text-slate-900',
						]}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<!-- CTA + 移动端菜单按钮 -->
		<div class="flex items-center gap-2">
			<a
				href="/products/ssl"
				class="hidden rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700 sm:inline-flex"
			>
				申请证书
			</a>
			<button
				id="menu-toggle"
				class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 md:hidden"
				aria-label="打开菜单"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>

	<!-- 移动端菜单 -->
	<nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-4 py-2 md:hidden">
		{
			navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						'block rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100',
						isActive(link.href) && 'bg-slate-100 text-slate-900',
					]}
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
	});
	// 点击菜单项后收起
	menu?.querySelectorAll('a').forEach((a) => {
		a.addEventListener('click', () => menu.classList.add('hidden'));
	});
</script>
