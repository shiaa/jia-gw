---
import { site } from '../data/site';
const { contact } = site;
---

<!-- 关于我们 / 联系我们 —— 备案合规信息区块 -->
<section id="about" class="section-alt relative overflow-hidden">
	<div aria-hidden class="pointer-events-none absolute inset-0">
		<div class="bg-blob -top-20 right-0 h-72 w-72 bg-brand-500/10 dark:bg-brand-500/10" />
		<div class="bg-blob bottom-0 left-0 h-64 w-64 bg-purple-500/10 dark:bg-purple-500/10" />
	</div>
	<div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
			<!-- 公司简介 -->
			<div>
				<span class="text-sm font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">About</span>
				<h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">关于我们</h2>
				<p class="mt-4 text-base leading-relaxed text-slate-600 dark:text-slate-400">
					{site.description}
				</p>
				<p class="mt-6 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-500 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
					</svg>
					{site.companyName}
				</p>
			</div>

			<!-- 联系我们 -->
			<div>
				<span class="text-sm font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">Contact</span>
				<h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">联系我们</h2>
				<p class="mt-3 text-base text-slate-600 dark:text-slate-400">
					欢迎随时与我们取得联系，获取专业的 SSL 证书与安全合规服务。
				</p>
				<ul class="mt-8 space-y-6">
					<li class="flex items-start gap-4">
						<span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</span>
						<div>
							<p class="text-sm text-slate-500">邮箱</p>
							<a href={`mailto:${contact.email}`} class="text-slate-700 transition hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-300">{contact.email}</a>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
							</svg>
						</span>
						<div>
							<p class="text-sm text-slate-500">电话</p>
							<a href={`tel:${contact.phone}`} class="text-slate-700 transition hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-300">{contact.phone}</a>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
							</svg>
						</span>
						<div>
							<p class="text-sm text-slate-500">地址</p>
							<p class="text-slate-700 dark:text-slate-300">{contact.address}</p>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
