---
interface Props {
	title?: string;
	subtitle?: string;
}
const {
	title = '准备好开启安全合规之旅了吗？',
	subtitle = '联系我们的安全专家，获取 SSL 证书方案与专属报价。',
} = Astro.props;
---

<section class="relative overflow-hidden border-y border-slate-200 bg-gradient-to-r from-brand-700 via-brand-600 to-brand-500 dark:border-white/10 dark:bg-night-900">
	<div aria-hidden class="pointer-events-none absolute inset-0">
		<div class="absolute left-1/2 top-0 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-white/10 blur-3xl" />
	</div>
	<div class="relative mx-auto max-w-6xl px-4 py-20 text-center sm:px-6">
		<h2 class="text-3xl font-bold text-white sm:text-4xl">{title}</h2>
		<p class="mx-auto mt-4 max-w-xl text-brand-100">{subtitle}</p>
		<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href="/products/ssl"
				class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-700 shadow-lg transition hover:bg-brand-50"
			>
				查看 SSL 产品
			</a>
			<a
				href="/contact"
				class="inline-flex items-center justify-center rounded-lg border border-white/40 px-8 py-3 text-base font-semibold text-white transition hover:bg-white/10"
			>
				联系我们
			</a>
		</div>
	</div>
</section>
