---
import { site, navLinks, products } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
		<!-- 品牌 -->
		<div class="md:col-span-2">
			<div class="flex items-center gap-2 text-lg font-bold text-brand-600">
				<span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white">A</span>
				<span>{site.brand}</span>
			</div>
			<p class="mt-3 max-w-sm text-sm leading-relaxed text-slate-500">
				{site.description}
			</p>
		</div>

		<!-- 导航 -->
		<div>
			<h3 class="text-sm font-semibold text-slate-900">快速导航</h3>
			<ul class="mt-3 space-y-2 text-sm text-slate-600">
				{navLinks.map((link) => (
					<li><a href={link.href} class="hover:text-brand-600">{link.label}</a></li>
				))}
			</ul>
		</div>

		<!-- 产品与合规 -->
		<div>
			<h3 class="text-sm font-semibold text-slate-900">产品与合规</h3>
			<ul class="mt-3 space-y-2 text-sm text-slate-600">
				{products.map((p) => (
					<li><a href={p.href} class="hover:text-brand-600">{p.name}</a></li>
				))}
				<li><a href="/legal/privacy" class="hover:text-brand-600">隐私政策</a></li>
				<li><a href="/legal/terms" class="hover:text-brand-600">服务条款</a></li>
			</ul>
		</div>
	</div>

	<!-- 底部备案 -->
	<div class="border-t border-slate-200">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:px-6">
			<p>© {year} {site.companyName} 保留所有权利</p>
			<a
				href={site.icpLink}
				target="_blank"
				rel="noopener noreferrer"
				class="hover:text-brand-600"
			>
				{site.icp}
			</a>
		</div>
	</div>
</footer>
