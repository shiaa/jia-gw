---
interface Props {
	name: string;
	short: string;
	href: string;
	status?: 'available' | 'coming';
}
const { name, short, href, status = 'available' } = Astro.props;
---

<a
	href={href}
	class="group dark-card flex flex-col p-6 hover:-translate-y-1"
>
	<span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-500/15 text-brand-300 transition group-hover:bg-gradient-to-br group-hover:from-brand-500 group-hover:to-brand-600 group-hover:text-white">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
		</svg>
	</span>
	<h3 class="mt-4 text-lg font-bold text-white">{name}</h3>
	<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{short}</p>
	<span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-300 transition group-hover:text-brand-200">
		了解更多
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
		</svg>
	</span>
</a>
