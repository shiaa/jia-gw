---
import { site } from '../data/site';

/**
 * 在线客服组件
 * - 第三方平台：在下方 `chatScript` 填入平台嵌入代码（推荐网易七鱼 / 美洽 等国内平台）即启用实时聊天。
 * - 邮件回退：未配置第三方时，展示"邮件咨询"悬浮面板（mailto）。
 */

// TODO: 填入第三方客服平台的嵌入代码（如网易七鱼 / 美洽 / Tawk.to）
// 示例：`<script>...平台生成代码...</script>`
const chatScript = '';

const { contact } = site;
---

{
	chatScript && <Fragment set:html={chatScript} />
}

<!-- 邮件咨询回退按钮 -->
<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
	<div
		id="chat-panel"
		class="hidden w-72 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-black/10 dark:border-white/15 dark:bg-night-900 dark:shadow-black/50"
	>
		<div class="flex items-center justify-between bg-gradient-to-r from-brand-600 to-brand-500 px-4 py-3 text-white">
			<div>
				<p class="text-sm font-semibold">在线咨询</p>
				<p class="text-xs text-brand-100">我们会在工作日尽快回复</p>
			</div>
			<button id="chat-close" class="text-white/80 hover:text-white" aria-label="关闭">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
		<div class="p-4">
			<p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
				如需快速帮助，欢迎通过以下方式联系我们：
			</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li>
					<a
						href={`tencent://message/?uin=${contact.qq}&site=qq&menu=yes`}
						class="flex items-center gap-2 rounded-lg bg-brand-500/10 px-3 py-2 font-medium text-brand-700 transition hover:bg-brand-500/20 dark:bg-brand-500/15 dark:text-brand-300 dark:hover:bg-brand-500/25"
					>
						QQ 咨询：{contact.qq}
					</a>
				</li>
				<li>
					<a
						href={`mailto:${contact.email}`}
						class="flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-2 font-medium text-slate-700 transition hover:bg-slate-200 dark:bg-white/5 dark:text-slate-300 dark:hover:bg-white/10"
					>
						邮箱：{contact.email}
					</a>
				</li>
			</ul>

			<!-- 留下联系方式 -->
			<div class="mt-5 border-t border-slate-200 pt-4 dark:border-white/10">
				<p class="text-sm font-semibold text-slate-900 dark:text-white">留下联系方式</p>
				<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">留下你的联系方式，我们会尽快回复你。</p>
				<form id="chat-contact-form" class="mt-3 space-y-2">
					<input type="hidden" name="access_key" value="dfc0786c-d677-4b41-ac0d-63d0884f5e61" />
					<input type="hidden" name="subject" value="官网在线咨询-留下联系方式" />
					<input
						id="chat-name"
						name="姓名"
						type="text"
						required
						placeholder="你的称呼"
						class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30 dark:border-white/10 dark:bg-night-800 dark:text-white dark:placeholder:text-slate-500"
					/>
					<input
						id="chat-phone"
						name="联系方式"
						type="text"
						required
						placeholder="手机号 / 微信号 / QQ"
						class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30 dark:border-white/10 dark:bg-night-800 dark:text-white dark:placeholder:text-slate-500"
					/>
					<button
						type="submit"
						class="w-full rounded-lg bg-gradient-to-r from-brand-500 to-brand-600 px-3 py-2 text-sm font-semibold text-white transition hover:from-brand-400 hover:to-brand-500"
					>
						提交
					</button>
					<p id="chat-form-status" class="text-center text-xs text-slate-500"></p>
				</form>
			</div>
		</div>
	</div>

	<button
		id="chat-toggle"
		class="grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-600 text-white shadow-lg shadow-brand-500/40 transition hover:scale-105"
		aria-label="打开在线咨询"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
		</svg>
	</button>
</div>

<script>
	const toggle = document.getElementById('chat-toggle');
	const panel = document.getElementById('chat-panel');
	const closeBtn = document.getElementById('chat-close');

	toggle?.addEventListener('click', () => {
		panel?.classList.remove('hidden');
		panel?.classList.add('flex');
		toggle?.classList.add('hidden');
	});
	closeBtn?.addEventListener('click', () => {
		panel?.classList.add('hidden');
		panel?.classList.remove('flex');
		toggle?.classList.remove('hidden');
	});

	// 留下联系方式表单提交
	const contactForm = document.getElementById('chat-contact-form');
	const contactStatus = document.getElementById('chat-form-status');

	contactForm?.addEventListener('submit', async (e) => {
		e.preventDefault();

		const button = contactForm.querySelector('button[type="submit"]');
		const original = button?.textContent;
		if (button) {
			button.disabled = true;
			button.textContent = '提交中…';
		}
		if (contactStatus) contactStatus.textContent = '正在提交，请稍候…';

		try {
			const formData = new FormData(contactForm);
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				body: formData,
			});
			const data = await response.json();

			if (data.success) {
				if (contactStatus) {
					contactStatus.textContent = '提交成功，我们会尽快联系你！';
					contactStatus.className = 'text-center text-xs font-medium text-emerald-600 dark:text-emerald-400';
				}
				contactForm.reset();
			} else {
				throw new Error(data.message || '提交失败');
			}
		} catch (err) {
			if (contactStatus) {
				contactStatus.textContent = '提交失败，请稍后重试。';
				contactStatus.className = 'text-center text-xs font-medium text-red-500';
			}
		} finally {
			if (button) {
				button.disabled = false;
				button.textContent = original;
			}
		}
	});
</script>
