---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { site } from '../../data/site';

const certTypes = [
	{
		type: 'DV 证书',
		level: '域名型',
		validity: '验证域名所有权，分钟级签发',
		trust: '基础加密保护',
		apply: '个人 / 个人网站',
	},
	{
		type: 'OV 证书',
		level: '企业型',
		validity: '验证企业资质，增强信任',
		trust: '企业身份验证',
		apply: '企业官网 / 中小企业',
	},
	{
		type: 'EV 证书',
		level: '增强企业型',
		validity: '严格企业审核，最高信任等级',
		trust: '地址栏显示企业名',
		apply: '金融 / 政企 / 大型企业',
	},
];
---

<BaseLayout title="SSL 证书" description={`一站式 SSL 证书签发与管理，快速签发 DV/OV/EV 证书。`}>
	<section class="border-b border-slate-200 bg-slate-50">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
			<h1 class="text-4xl font-extrabold text-slate-900">SSL 证书平台</h1>
			<p class="mt-3 max-w-2xl text-lg text-slate-600">
				一站式 SSL 证书签发与管理服务，快速签发 DV/OV/EV 证书，
				为你的网站开启 HTTPS 加密，提升用户信任。
			</p>
			<div class="mt-8">
				<a
					href={site.sslUrl}
					class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-8 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700"
				>
					进入证书平台
				</a>
			</div>
		</div>
	</section>

	<!-- 证书类型对比 -->
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="text-2xl font-bold text-slate-900">证书类型对比</h2>
		<p class="mt-3 max-w-2xl text-slate-500">
			根据业务需求选择合适的证书类型，为不同场景提供匹配的信任等级。
		</p>
		<div class="mt-8 overflow-x-auto">
			<table class="w-full min-w-[640px] border-collapse rounded-lg border border-slate-200 text-left text-sm">
				<thead>
					<tr class="bg-slate-50 text-slate-900">
						<th class="border border-slate-200 px-4 py-3 font-semibold">类型</th>
						<th class="border border-slate-200 px-4 py-3 font-semibold">信任等级</th>
						<th class="border border-slate-200 px-4 py-3 font-semibold">验证要求</th>
						<th class="border border-slate-200 px-4 py-3 font-semibold">浏览器标识</th>
						<th class="border border-slate-200 px-4 py-3 font-semibold">适用场景</th>
					</tr>
				</thead>
				<tbody>
					{
						certTypes.map((c) => (
							<tr class="border border-slate-200 align-top hover:bg-slate-50">
								<td class="border border-slate-200 px-4 py-3 font-medium text-brand-600">
									{c.type}<span class="ml-1 text-xs font-normal text-slate-400">{c.level}</span>
								</td>
								<td class="border border-slate-200 px-4 py-3 text-slate-700">{c.trust}</td>
								<td class="border border-slate-200 px-4 py-3 text-slate-600">{c.validity}</td>
								<td class="border border-slate-200 px-4 py-3 text-slate-600">{c.trust}</td>
								<td class="border border-slate-200 px-4 py-3 text-slate-600">{c.apply}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<!-- 签发流程 -->
	<section class="bg-slate-50 py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 class="text-2xl font-bold text-slate-900">申请流程</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-4">
				{
					[
						{ step: '01', title: '选择证书', desc: '根据需求选择证书类型' },
						{ step: '02', title: '提交信息', desc: '填写域名与验证信息' },
						{ step: '03', title: '完成验证', desc: '按指引完成域名/企业验证' },
						{ step: '04', title: '签发部署', desc: '证书签发并安装上线' },
					].map((s) => (
						<div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
							<span class="text-3xl font-extrabold text-brand-200">{s.step}</span>
							<h3 class="mt-3 text-base font-bold text-slate-900">{s.title}</h3>
							<p class="mt-1 text-sm text-slate-500">{s.desc}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<CTASection title="为你的网站开启 HTTPS" subtitle="快速签发、专业支持，立即申请 SSL 证书。" />
</BaseLayout>
