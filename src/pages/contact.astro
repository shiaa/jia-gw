---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
const { contact } = site;
---

<BaseLayout title="联系我们" description={`通过多种方式与${site.companyName}取得联系。`}>
	<!-- 页头 -->
	<section class="page-hero">
		<div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<span class="text-sm font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">Contact</span>
			<h1 class="mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">联系我们</h1>
			<p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
				无论是产品咨询、技术支持还是合作洽谈，欢迎随时与我们联系。
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="grid gap-10 md:grid-cols-2">
			<!-- 联系信息 -->
			<div>
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white">联系方式</h2>
				<ul class="mt-6 space-y-6">
					<li class="flex items-start gap-4">
						<span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</span>
						<div>
							<p class="text-sm text-slate-500">邮箱</p>
							<a href={`mailto:${contact.email}`} class="text-slate-700 transition hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-300">{contact.email}</a>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
							</svg>
						</span>
						<div>
							<p class="text-sm text-slate-500">电话</p>
							<a href={`tel:${contact.phone}`} class="text-slate-700 transition hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-300">{contact.phone}</a>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
							</svg>
						</span>
						<div>
							<p class="text-sm text-slate-500">地址</p>
							<p class="text-slate-700 dark:text-slate-300">{contact.address}</p>
						</div>
					</li>
				</ul>
			</div>

			<!-- 表单（mailto 提交，不接后端） -->
			<div class="dark-card p-8">
				<h2 class="text-xl font-bold text-slate-900 dark:text-white">给我们留言</h2>
				<form
					action={`mailto:${contact.email}`}
					method="post"
					enctype="text/plain"
					class="mt-6 space-y-4"
				>
					<div>
						<label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-300">姓名</label>
						<input
							id="name"
							name="姓名"
							type="text"
							required
							placeholder="你的姓名"
							class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30 dark:border-white/10 dark:bg-night-800 dark:text-white dark:placeholder:text-slate-500"
						/>
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300">邮箱</label>
						<input
							id="email"
							name="邮箱"
							type="email"
							required
							placeholder="you@example.com"
							class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30 dark:border-white/10 dark:bg-night-800 dark:text-white dark:placeholder:text-slate-500"
						/>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-300">留言内容</label>
						<textarea
							id="message"
							name="留言"
							rows="5"
							required
							placeholder="请描述你的需求…"
							class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30 dark:border-white/10 dark:bg-night-800 dark:text-white dark:placeholder:text-slate-500"
						></textarea>
					</div>
					<button
						type="submit"
						class="w-full rounded-lg bg-gradient-to-r from-brand-500 to-brand-600 px-4 py-3 text-sm font-semibold text-white transition hover:from-brand-400 hover:to-brand-500"
					>
						发送邮件
					</button>
					<p class="text-center text-xs text-slate-500">
						当前为演示表单，提交将唤起邮件客户端发送。
					</p>
				</form>
			</div>
		</div>
	</section>
</BaseLayout>
