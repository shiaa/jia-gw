---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import SolutionCard from '../components/SolutionCard.astro';
import CTASection from '../components/CTASection.astro';
import { products, solutions, advantages } from '../data/site';
---

<BaseLayout>
	<Hero />

	<!-- 产品线 -->
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="text-center">
			<h2 class="text-3xl font-bold text-slate-900">产品与服务</h2>
			<p class="mx-auto mt-3 max-w-xl text-slate-500">
				以 SSL 证书为核心，持续构建安全可信的基础服务生态。
			</p>
		</div>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				products.map((p) => (
					<ProductCard name={p.name} short={p.short} href={p.href} status={p.status} />
				))
			}
		</div>
	</section>

	<!-- 解决方案 -->
	<section class="bg-slate-50 py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="text-center">
				<h2 class="text-3xl font-bold text-slate-900">行业解决方案</h2>
				<p class="mx-auto mt-3 max-w-xl text-slate-500">
					针对不同行业的业务特点，提供定制化的安全与合规方案。
				</p>
			</div>
			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{solutions.map((s) => <SolutionCard title={s.title} desc={s.desc} />)}
			</div>
		</div>
	</section>

	<!-- 为什么选择我们 -->
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="text-center">
			<h2 class="text-3xl font-bold text-slate-900">为什么选择我们</h2>
			<p class="mx-auto mt-3 max-w-xl text-slate-500">
				以专业的技术能力与贴心服务，护航你的每一次安全部署。
			</p>
		</div>
		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				advantages.map((a) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
						<span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-50 text-brand-600">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
						</span>
						<h3 class="mt-4 text-lg font-bold text-slate-900">{a.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-500">{a.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<CTASection />
</BaseLayout>
